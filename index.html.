<script>
const canvas=document.getElementById('sky'),ctx=canvas.getContext('2d');let W=innerWidth,H=innerHeight,DPR=1,stars=[],dust=[],tick=0;function resize(){W=innerWidth;H=innerHeight;DPR=Math.min(devicePixelRatio||1,1.5);canvas.width=W*DPR;canvas.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);stars=Array.from({length:Math.min(450,Math.floor(W*H/2200))},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.2+.2,a:Math.random()*.7,p:Math.random()*6.28}));dust=Array.from({length:1500},()=>({a:Math.random()*6.28,r:Math.sqrt(Math.random())*Math.min(W,H)*.7,z:Math.random(),s:(Math.random()*.001+.0002)*(Math.random()<.5?-1:1),p:Math.random()*6.28,sz:Math.random()*1.4+.2,c:Math.random()<.7?'#d66aff':'#83fff3'}));}function draw(){tick+=.008;ctx.clearRect(0,0,W,H);for(const s of stars){ctx.globalAlpha=s.a*(.5+.5*Math.sin(tick+s.p));ctx.fillStyle='#e5d6ff';ctx.fillRect(s.x,s.y,s.r,s.r)}for(const d of dust){d.a+=d.s;let x=W/2+Math.cos(d.a+tick*.12)*d.r*(.7+d.z*.5),y=H/2+Math.sin(d.a+tick*.12)*d.r*(.7+d.z*.5)*.65;ctx.globalAlpha=.18+.65*(.5+.5*Math.sin(tick*2+d.p));ctx.fillStyle=d.c;ctx.beginPath();ctx.arc(x,y,d.sz,0,6.283);ctx.fill()}ctx.globalAlpha=1;requestAnimationFrame(draw)}resize();draw();addEventListener('resize',resize,{passive:true});
// Opening sequence: many tiny heart particles clearly form the title, hold briefly, then burst to reveal the 3D sphere.
(()=>{
 const hc=document.getElementById('heartShow'),hctx=hc.getContext('2d',{alpha:true});let hw=innerWidth,hh=innerHeight,hdpr=1,particles=[],targets=[],startedAt=0,finished=false,raf=0;
 const palette=['#ff79e8','#d7a0ff','#8eeaff'];
 function heartPath(c,x,y,s){c.moveTo(x,y+s*.32);c.bezierCurveTo(x-s*.85,y-s*.25,x-s*.48,y-s*.78,x,y-s*.28);c.bezierCurveTo(x+s*.48,y-s*.78,x+s*.85,y-s*.25,x,y+s*.32);}
 function makeTargets(){
  const off=document.createElement('canvas'),o=off.getContext('2d');off.width=Math.max(1,Math.floor(hw*.9));off.height=Math.max(1,Math.floor(hh*.42));
  const title=(document.getElementById('tapHeroTitle')?.textContent||'A WORLD OF YOU').trim().replace(/\s+/g,' ');
  const words=title.split(' ');let lines=['',''];
  if(words.length===1){const cut=Math.ceil(words[0].length/2);lines=[words[0].slice(0,cut),words[0].slice(cut)||''];}
  else {let a='',b='';for(const word of words){const candidate=(a+' '+word).trim();if(!a||candidate.length<=Math.ceil(title.length/2)+1)a=candidate;else b=(b+' '+word).trim();}lines=[a,b||words[words.length-1]];}
  const maxChars=Math.max(lines[0].length,lines[1].length,5);
  let fs=Math.min(off.width/(maxChars*.59),off.height*.34,104);if(hw<600)fs=Math.min(fs,off.width/(maxChars*.64),62);
  o.font=`800 ${fs}px system-ui, sans-serif`;o.textAlign='center';o.textBaseline='middle';o.fillStyle='#fff';
  const centerY=hh*.43, lineGap=fs*1.13;
  lines.forEach((line,i)=>{if(line)o.fillText(line,off.width/2,off.height/2+(i===0?-lineGap/2:lineGap/2),off.width*.98)});
  const data=o.getImageData(0,0,off.width,off.height).data,pts=[];const step=2;
  for(let y=0;y<off.height;y+=step)for(let x=0;x<off.width;x+=step){if(data[(y*off.width+x)*4+3]>80){const row=y<off.height/2?0:1;pts.push({x:hw/2-off.width/2+x,y:centerY-off.height/2+y,wave:row});}}
  return pts;
 }
 function resetHearts(){
  hw=innerWidth;hh=innerHeight;hdpr=Math.min(devicePixelRatio||1,1.5);hc.width=Math.round(hw*hdpr);hc.height=Math.round(hh*hdpr);hc.style.width=hw+'px';hc.style.height=hh+'px';hctx.setTransform(hdpr,0,0,hdpr,0,0);targets=makeTargets();
  const count=Math.min(hw<600?7600:11500,Math.max(hw<600?6200:8500,Math.floor(hw*hh/(hw<600?105:95))));
  particles=Array.from({length:count},(_,i)=>{const t=targets[(i*7)%Math.max(1,targets.length)]||{x:hw/2,y:hh/2};return {x:Math.random()*hw,y:Math.random()*hh,vx:(Math.random()-.5)*1.2,vy:(Math.random()-.5)*1.2,tx:t.x+(Math.random()-.5)*1.4,ty:t.y+(Math.random()-.5)*1.4,wave:t.wave??(t.x<hw/2?0:1),size:Math.random()*1.9+1.7,phase:Math.random()*6.28,color:Math.random()<.64?0:(Math.random()<.72?1:2),seed:Math.random()*1000,burstV:(Math.random()*.7+.65)}});
 }
 resetHearts();addEventListener('resize',()=>{if(!finished)resetHearts()},{passive:true});
 function animate(now){if(finished)return;const t=(now-startedAt)/1000;hctx.clearRect(0,0,hw,hh);
  const phase1=Math.max(0,Math.min(1,(t-.7)/3.0));
  const phase2=Math.max(0,Math.min(1,(t-3.7)/3.0));
  const hold=Math.max(0,Math.min(1,(t-6.7)/.8));
  const burst=Math.max(0,Math.min(1,(t-7.5)/2.0));
  const fade=t<7.5?1:Math.max(0,1-(t-7.5)/2.0);
  const groups=Array.from({length:9},()=>[]);
  for(const p of particles){
   if(t<.5){p.x+=p.vx*.55+Math.sin(t*1.4+p.phase)*.18;p.y+=p.vy*.55+Math.cos(t*1.3+p.phase)*.18;}
   else if(t<7.5){const waveProgress=p.wave===0?phase1:phase2;const active=p.wave===0||t>=3.7;const ease=active?(.012+waveProgress*.075):.001;const wobble=(1-hold)*.08;p.x+=(p.tx-p.x)*ease+Math.sin(t*2.4+p.phase)*wobble;p.y+=(p.ty-p.y)*ease+Math.cos(t*2.1+p.phase)*wobble;}
   else {const dx=p.x-hw/2,dy=p.y-hh*.43,dist=Math.hypot(dx,dy)||1;const power=(2.2+burst*9)*p.burstV;p.x+=dx/dist*power+Math.sin(p.seed+t)*.45;p.y+=dy/dist*power+Math.cos(p.seed+t)*.45;p.x+=p.vx;p.y+=p.vy;}
   const pulse=.78+.22*Math.sin(t*3+p.phase);const alpha=(t<.5?.68+.28*Math.sin(t*2.5+p.phase):t<7.5?.78+.18*(p.wave===0?phase1:phase2):fade)*pulse;
   if(alpha<.025)continue;const aBin=alpha<.48?0:(alpha<.72?1:2);groups[p.color*3+aBin].push(p);
  }
  // Batch paths by colour to keep hundreds of hearts smooth even on phones.
  for(let g=0;g<groups.length;g++){if(!groups[g].length)continue;const color=Math.floor(g/3),aBin=g%3;hctx.beginPath();for(const p of groups[g])heartPath(hctx,p.x,p.y,p.size*(t>7.7?Math.max(.35,1-burst*.55):1));hctx.globalAlpha=[.42,.68,.92][aBin];hctx.fillStyle=palette[color];hctx.shadowColor=palette[color];hctx.shadowBlur=t>7.3?0:3;hctx.fill();}
  hctx.globalAlpha=1;hctx.shadowBlur=0;
  if(t>9.7){finished=true;hc.classList.add('done');setTimeout(()=>{if(finished)hc.style.display='none'},1250);return;}raf=requestAnimationFrame(animate);
 }
 window.playHeartShow=()=>{if(raf)cancelAnimationFrame(raf);startedAt=performance.now();finished=false;hc.style.display='block';hc.classList.remove('done');resetHearts();raf=requestAnimationFrame(animate)};
})();
const sphere=document.getElementById('sphere'),inside=document.getElementById('inside'),insideCloud=document.getElementById('insideCloud');let photoUrls=[],started=false,paused=false,flowOpen=false;function buildSphere(){sphere.innerHTML='';let n=Math.max(90,Math.min(150,photoUrls.length?photoUrls.length*4:100));for(let i=0;i<n;i++){let el=document.createElement('div');el.className='tile';let y=1-2*(i+.5)/n,rr=Math.sqrt(1-y*y),theta=i*Math.PI*(3-Math.sqrt(5)),x=Math.cos(theta)*rr,z=Math.sin(theta)*rr;let yaw=Math.atan2(x,z)*180/Math.PI,pitch=-Math.asin(y)*180/Math.PI;let radius=Math.min(205,Math.min(W,H)*.255);let final=`rotateY(${yaw}deg) rotateX(${pitch}deg) translateZ(${radius}px)`;el.dataset.final=final;el.style.transform=`translate3d(${(Math.random()-.5)*W*1.4}px,${(Math.random()-.5)*H*1.2}px,${(Math.random()-.5)*400}px) rotateX(${Math.random()*360}deg) scale(.3)`;el.style.opacity='0';if(photoUrls.length){let img=document.createElement('img');img.src=photoUrls[i%photoUrls.length];img.alt='Ảnh kỷ niệm';el.appendChild(img)}else el.classList.add('placeholder');sphere.appendChild(el)}}function formSphere(){[...sphere.children].forEach((el,i)=>{el.style.transitionDelay=(Math.random()*900)+'ms';el.style.opacity='1';el.style.transform=el.dataset.final});setTimeout(()=>[...sphere.children].forEach(el=>el.style.transitionDelay='0ms'),3200)}buildSphere();
document.getElementById('start').onclick=()=>{if(!started){started=true;document.getElementById('intro').classList.add('hide');document.getElementById('orbArea').classList.add('show');requestAnimationFrame(()=>requestAnimationFrame(formSphere));setTimeout(()=>document.getElementById('caption').classList.add('show'),2200);document.getElementById('start').textContent='↻ Xem lại hiệu ứng'}else{started=false;document.getElementById('intro').classList.remove('hide');document.getElementById('orbArea').classList.remove('show');document.getElementById('caption').classList.remove('show');document.getElementById('start').textContent='✦ Bắt đầu hành trình';buildSphere()}};
document.getElementById('photos').onchange=e=>{for(let f of e.target.files){if(f.type.startsWith('image/'))photoUrls.push(URL.createObjectURL(f))}buildSphere();if(started)requestAnimationFrame(formSphere);e.target.value=''};document.getElementById('pause').onclick=()=>{paused=!paused;sphere.classList.toggle('paused',paused);document.getElementById('pause').textContent=paused?'▶ Tiếp tục':'Ⅱ Tạm dừng';document.querySelector('.nebula').style.animationPlayState=paused?'paused':'running'};
function enter(){if(!started)return;insideCloud.innerHTML='';let items=[...sphere.children],n=Math.min(items.length,60);for(let i=0;i<n;i++){let el=items[i].cloneNode(true),y=1-2*(i+.5)/n,rr=Math.sqrt(1-y*y),th=i*Math.PI*(3-Math.sqrt(5)),x=Math.cos(th)*rr,z=Math.sin(th)*rr;el.style.transform=`translate3d(${x*Math.min(W,H)*.32}px,${y*Math.min(W,H)*.32}px,${z*Math.min(W,H)*.32}px) rotateY(${Math.atan2(x,z)*180/Math.PI}deg) rotateX(${-Math.asin(y)*180/Math.PI}deg)`;el.style.opacity='.9';insideCloud.appendChild(el)}inside.classList.add('open')}sphere.addEventListener('click',enter);insideCloud.addEventListener('click',()=>{if(!flowOpen)buildFlow();flowOpen=!flowOpen;flow.classList.toggle('open',flowOpen)});document.getElementById('exit').onclick=()=>{inside.classList.remove('open');flowOpen=false;flow.classList.remove('open')};
const flow=document.getElementById('flow'),flowgrid=document.getElementById('flowgrid');function buildFlow(){flowgrid.innerHTML='';const cols=innerWidth<600?5:8,perCol=8;for(let c=0;c<cols;c++){const col=document.createElement('div');col.className='flowcol';col.style.setProperty('--dur',(14+Math.random()*7)+'s');col.style.setProperty('--delay',(-Math.random()*14)+'s');const sequence=Array.from({length:perCol},(_,j)=>photoUrls.length?(c*3+j)%photoUrls.length:-1);for(let pass=0;pass<2;pass++){for(const idx of sequence){const box=document.createElement('div');box.className='flowtile';if(idx>=0){const img=document.createElement('img');img.alt='Ảnh kỷ niệm';img.decoding='async';img.loading='eager';img.src=photoUrls[idx];img.onerror=()=>{box.innerHTML='';box.classList.add('empty')};box.appendChild(img)}else box.classList.add('empty');col.appendChild(box)}}flowgrid.appendChild(col)}}document.getElementById('flowToggle').onclick=()=>{if(!flowOpen)buildFlow();flowOpen=!flowOpen;flow.classList.toggle('open',flowOpen)};document.getElementById('flowClose').onclick=()=>{flowOpen=false;flow.classList.remove('open')};
const music=document.getElementById('music'),musicStatus=document.getElementById('musicStatus');let musicUrl;document.getElementById('musicFile').onchange=e=>{let f=e.target.files[0];if(!f)return;if(musicUrl)URL.revokeObjectURL(musicUrl);musicUrl=URL.createObjectURL(f);music.src=musicUrl;music.volume=.55;musicStatus.textContent='♫ '+f.name;musicStatus.classList.add('show')};document.getElementById('musicToggle').onclick=async()=>{if(!music.src){musicStatus.textContent='Chọn file nhạc trên thiết bị trước nhé';musicStatus.classList.add('show');document.getElementById('musicFile').click();return}if(music.paused){try{await music.play();document.getElementById('musicToggle').textContent='Ⅱ Tạm dừng nhạc'}catch{musicStatus.textContent='Không phát được tệp âm thanh này'}}else{music.pause();document.getElementById('musicToggle').textContent='▶ Phát nhạc'}};
const editor=document.getElementById('editor');let viewerMode=false;function applySettings(){document.getElementById('introTitle').textContent=document.getElementById('titleInput').value||'A WORLD OF YOU';document.getElementById('introSub').textContent=document.getElementById('subInput').value;document.getElementById('greeting').textContent=document.getElementById('greetingInput').value;document.getElementById('message').textContent=document.getElementById('messageInput').value;document.getElementById('tapTitle').textContent=document.getElementById('tapTitleInput').value||'BẮT ĐẦU HÀNH TRÌNH';document.getElementById('tapHeroTitle').textContent=document.getElementById('titleInput').value||'A WORLD OF YOU';document.getElementById('tapHeroSub').textContent=document.getElementById('subInput').value||'EVERY LITTLE MOMENT MATTERS';document.getElementById('tapSub').textContent='Chạm nhẹ vào màn hình để mở món quà'}document.getElementById('setupPhotos').onchange=e=>{for(const f of e.target.files){if(f.type.startsWith('image/'))photoUrls.push(URL.createObjectURL(f))}buildSphere();e.target.value=''};document.getElementById('setupMusic').onchange=e=>{const f=e.target.files[0];if(!f)return;if(musicUrl)URL.revokeObjectURL(musicUrl);musicUrl=URL.createObjectURL(f);music.src=musicUrl;music.volume=.55;musicStatus.textContent='♫ '+f.name;musicStatus.classList.add('show')};document.getElementById('save').onclick=()=>{applySettings();viewerMode=true;editor.classList.remove('open');document.querySelector('.controls').style.display='none';document.getElementById('intro').classList.add('hide');document.getElementById('orbArea').classList.remove('show');document.getElementById('caption').classList.remove('show');const tap=document.getElementById('tapStart');tap.style.display='none';tap.classList.add('hide');window.playHeartShow?.();setTimeout(()=>{document.getElementById('start').click();},10100);};document.getElementById('tapStart').onclick=async()=>{if(!viewerMode)return;document.getElementById('tapStart').classList.add('hide');setTimeout(()=>document.getElementById('tapStart').style.display='none',850);if(music.src&&music.paused){try{await music.play()}catch(e){}}document.getElementById('start').click()};document.getElementById('edit').onclick=()=>{viewerMode=false;document.querySelector('.controls').style.display='none';editor.classList.add('open')};
</script></body></html>
